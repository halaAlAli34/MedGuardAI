# Server
PORT=5000
NODE_ENV=development

# MongoDB (MongoDB Atlas free tier connection string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medguard?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# AI (Google Gemini - used for BOTH the risk explainer (text) and the
# prescription label scanner (vision/OCR)). Gemini has a genuinely free tier
# with no credit card required. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: override the model (defaults to gemini-flash-latest if unset,
# a Google-maintained alias that always points at their current recommended
# fast model - safer than pinning a specific version, which Google
# periodically retires)
GEMINI_MODEL=

# Cloudinary (free tier) - used to store uploaded prescription label photos.
# If left blank, the app falls back to local disk storage under /uploads
# (fine for local dev/demo, NOT recommended for production/Render free tier
# since local disk is ephemeral there).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
